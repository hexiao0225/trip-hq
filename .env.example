# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Database -------------------------------------------------------------
# Any Postgres connection string. Neon's free tier and Vercel Postgres both
# work; Neon is what the driver is tuned for.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Access ---------------------------------------------------------------
# The passcode you and your husband type once on each device.
APP_PASSCODE="pick-something-memorable"

# Signs the session cookie. Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-32-random-bytes"

# --- Email ingestion ------------------------------------------------------
# Used to parse forwarded booking confirmations.
# Parsing uses OpenAI when OPENAI_API_KEY is set:
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-6.1-terra"
# Otherwise it goes through Vercel AI Gateway. On Vercel it authenticates on its own;
# set a gateway key only to parse emails in local development.
# AI_GATEWAY_API_KEY=""
# AI_GATEWAY_MODEL="deepseek/deepseek-v4-flash"

# Shared secret the inbound-email webhook must present, either as
# ?token=... on the URL or an x-webhook-token header.
# Generate with:  openssl rand -hex 24
INBOUND_WEBHOOK_SECRET="replace-with-random-hex"
