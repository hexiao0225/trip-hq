# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Database -------------------------------------------------------------
# Any Postgres connection string. Neon's free tier and Vercel Postgres both
# work; Neon is what the driver is tuned for.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Access ---------------------------------------------------------------
# The passcode you and your husband type once on each device.
APP_PASSCODE="pick-something-memorable"

# Signs the session cookie. Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-32-random-bytes"

# --- Email ingestion ------------------------------------------------------
# Used to parse forwarded booking confirmations.
ANTHROPIC_API_KEY="sk-ant-..."

# Shared secret the inbound-email webhook must present, either as
# ?token=... on the URL or an x-webhook-token header.
# Generate with:  openssl rand -hex 24
INBOUND_WEBHOOK_SECRET="replace-with-random-hex"
